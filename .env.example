# Copiar a .env.local para desarrollo, y cargar las mismas en Vercel
# (Project Settings → Environment Variables).

# Supabase → Project Settings → Database → Connection string → "Transaction pooler"
# Tiene que ser el puerto 6543, NO el 5432. Ver el comentario en api/_lib/db.js
DATABASE_URL="postgresql://postgres.xxxx:CONTRASEÑA@aws-0-sa-east-1.pooler.supabase.com:6543/postgres"

# Supabase → Project Settings → API
SUPABASE_URL="https://xxxx.supabase.co"

# service_role, NO la anon. Saltea RLS: nunca puede terminar en el navegador.
SUPABASE_SERVICE_ROLE_KEY="eyJ..."

# Firma las cookies de sesión. Mínimo 32 caracteres al azar.
# Generar con:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=""

# Webhook de Make para los mails de bienvenida y recuperación.
# Si se deja vacío, la app anda igual pero no salen los mails.
MAKE_WEBHOOK_URL=""

# Para armar el link de recuperación de contraseña y los links de seguimiento.
# Si falta, se usa el dominio de producción que informa Vercel. Nunca se toma
# del header Host del pedido.
SITE_URL="https://impulsar.vercel.app"

# Clave que manda Make en /api/seguimientos_para_email?clave=...
# Generar con:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=""
